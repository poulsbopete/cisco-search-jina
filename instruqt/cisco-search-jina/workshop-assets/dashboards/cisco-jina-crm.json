{
  "title": "Cisco Jina \u2014 CRM Analytics",
  "description": "CRM pipeline and competitors from cisco-jina-corpus.",
  "tags": [
    "cisco",
    "jina",
    "workshop",
    "cisco-search-jina"
  ],
  "time_range": {
    "from": "now-24h",
    "to": "now"
  },
  "options": {
    "use_margins": true,
    "sync_colors": true,
    "sync_cursor": true,
    "sync_tooltips": false,
    "hide_panel_titles": false,
    "auto_apply_filters": true,
    "hide_panel_borders": false
  },
  "query": {
    "expression": "",
    "language": "kuery"
  },
  "filters": [],
  "panels": [
    {
      "id": "md-hero",
      "type": "markdown",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 48,
        "h": 4
      },
      "config": {
        "content": "## CRM Analytics\n\nPipeline $ by stage and competitor graph edges. Similar deals stay grounded in account / deal / competitor.",
        "settings": {
          "open_links_in_new_tab": true
        }
      }
    },
    {
      "id": "crm-stage",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "CRM pipeline $ by stage",
        "type": "xy",
        "axis": {
          "x": {
            "title": {
              "visible": false
            }
          },
          "y": {
            "title": {
              "visible": false
            }
          }
        },
        "layers": [
          {
            "type": "bar",
            "data_source": {
              "type": "esql",
              "query": "FROM \"cisco-jina-corpus\"\n| WHERE source == \"crm\"\n| STATS deals = COUNT(*), pipeline = SUM(amount) BY stage\n| SORT pipeline DESC"
            },
            "x": {
              "column": "stage"
            },
            "y": [
              {
                "column": "pipeline"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "crm-comp",
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "CRM competitors",
        "type": "xy",
        "axis": {
          "x": {
            "title": {
              "visible": false
            }
          },
          "y": {
            "title": {
              "visible": false
            }
          }
        },
        "layers": [
          {
            "type": "bar_horizontal",
            "data_source": {
              "type": "esql",
              "query": "FROM \"cisco-jina-corpus\"\n| WHERE source == \"crm\"\n| MV_EXPAND competitors\n| STATS deals = COUNT(*) BY competitors\n| SORT deals DESC"
            },
            "x": {
              "column": "competitors"
            },
            "y": [
              {
                "column": "deals"
              }
            ]
          }
        ]
      }
    }
  ]
}
