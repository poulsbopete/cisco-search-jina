{
  "title": "Cisco Jina \u2014 CRM Analytics",
  "description": "CRM pipeline and competitors from cisco-jina-corpus.",
  "tags": [
    "cisco",
    "jina",
    "workshop",
    "cisco-search-jina"
  ],
  "time_range": {
    "from": "now-7d",
    "to": "now"
  },
  "options": {
    "use_margins": true,
    "sync_colors": true,
    "sync_cursor": true,
    "sync_tooltips": false,
    "hide_panel_titles": false,
    "auto_apply_filters": true,
    "hide_panel_borders": false
  },
  "query": {
    "expression": "",
    "language": "kql"
  },
  "filters": [],
  "panels": [
    {
      "id": "md-hero",
      "type": "markdown",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 48,
        "h": 7
      },
      "config": {
        "content": "## CRM Analytics\n\n_Refreshed by **Workflows \u2192 Cisco Jina Workshop \u2014 Dashboard notes** (every 10 minutes)._\n\n**What you are looking at**\n- Pipeline dollars and deal counts by Salesforce stage\n- Competitor graph for similar-deal narratives\n\n**Talking point:** find deals like Acme\u2019s Webex renewal with a reason for every match.\n",
        "settings": {
          "open_links_in_new_tab": true
        }
      }
    },
    {
      "id": "kpi-crm",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 5
      },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"crm\"\n| STATS crm_deals = COUNT(*)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "crm_deals"
          }
        ]
      }
    },
    {
      "id": "kpi-pipeline",
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 7,
        "w": 24,
        "h": 5
      },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"crm\"\n| STATS pipeline_usd = SUM(amount)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "pipeline_usd"
          }
        ]
      }
    },
    {
      "id": "crm-stage",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "CRM pipeline $ by stage",
        "type": "data_table",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"crm\"\n| STATS deals = COUNT(*), pipeline = SUM(amount) BY stage\n| SORT pipeline DESC"
        },
        "sampling": 1,
        "ignore_global_filters": false,
        "rows": [
          {
            "column": "stage"
          },
          {
            "column": "deals"
          },
          {
            "column": "pipeline"
          }
        ],
        "styling": {
          "paging": 10
        }
      }
    },
    {
      "id": "crm-comp",
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "CRM competitors",
        "type": "pie",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"crm\"\n| MV_EXPAND competitors\n| STATS deals = COUNT(*) BY competitors"
        },
        "metrics": [
          {
            "column": "deals"
          }
        ],
        "group_by": [
          {
            "column": "competitors"
          }
        ],
        "styling": {
          "donut_hole": "m"
        }
      }
    }
  ]
}
