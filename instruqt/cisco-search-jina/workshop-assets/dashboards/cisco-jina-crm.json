{
  "title": "Cisco Jina — CRM Analytics",
  "description": "CRM pipeline and competitors from cisco-jina-corpus.",
  "tags": ["cisco", "jina", "workshop", "cisco-search-jina"],
  "time_range": { "from": "now-7d", "to": "now" },
  "options": {
    "use_margins": true,
    "sync_colors": true,
    "sync_cursor": true,
    "sync_tooltips": false,
    "hide_panel_titles": false,
    "auto_apply_filters": true,
    "hide_panel_borders": false
  },
  "query": { "expression": "", "language": "kql" },
  "filters": [],
  "panels": [
    {
      "id": "md-hero",
      "type": "markdown",
      "grid": { "x": 0, "y": 0, "w": 48, "h": 4 },
      "config": {
        "content": "## CRM Analytics\n\nPipeline $ by stage and competitor graph edges. Similar deals stay grounded in account / deal / competitor.",
        "settings": { "open_links_in_new_tab": true }
      }
    },
    {
      "id": "kpi-crm",
      "type": "vis",
      "grid": { "x": 0, "y": 4, "w": 24, "h": 5 },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"crm\"\n| STATS `CRM deals` = COUNT(*)"
        },
        "metrics": [{ "type": "primary", "column": "CRM deals" }]
      }
    },
    {
      "id": "kpi-pipeline",
      "type": "vis",
      "grid": { "x": 24, "y": 4, "w": 24, "h": 5 },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"crm\"\n| STATS `Pipeline $` = SUM(amount)"
        },
        "metrics": [{ "type": "primary", "column": "Pipeline $" }]
      }
    },
    {
      "id": "crm-stage",
      "type": "vis",
      "grid": { "x": 0, "y": 9, "w": 24, "h": 12 },
      "config": {
        "title": "CRM pipeline $ by stage",
        "type": "data_table",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"crm\"\n| STATS deals = COUNT(*), pipeline = SUM(amount) BY stage\n| SORT pipeline DESC"
        },
        "sampling": 1,
        "ignore_global_filters": false,
        "rows": [
          { "column": "stage" },
          { "column": "deals" },
          { "column": "pipeline" }
        ],
        "styling": { "paging": 10 }
      }
    },
    {
      "id": "crm-comp",
      "type": "vis",
      "grid": { "x": 24, "y": 9, "w": 24, "h": 12 },
      "config": {
        "title": "CRM competitors",
        "type": "pie",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"crm\"\n| MV_EXPAND competitors\n| STATS deals = COUNT(*) BY competitors"
        },
        "metrics": [{ "column": "deals" }],
        "group_by": [{ "column": "competitors" }],
        "styling": { "donut_hole": "m" }
      }
    }
  ]
}
