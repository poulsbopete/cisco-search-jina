{
  "title": "Cisco Jina \u2014 Lifecycle federated search",
  "description": "Snowflake / S3 / Elastic lifecycle docs.",
  "tags": [
    "cisco",
    "jina",
    "workshop",
    "cisco-search-jina"
  ],
  "time_range": {
    "from": "now-7d",
    "to": "now"
  },
  "options": {
    "use_margins": true,
    "sync_colors": true,
    "sync_cursor": true,
    "sync_tooltips": false,
    "hide_panel_titles": false,
    "auto_apply_filters": true,
    "hide_panel_borders": false
  },
  "query": {
    "expression": "",
    "language": "kql"
  },
  "filters": [],
  "panels": [
    {
      "id": "md-hero",
      "type": "markdown",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 48,
        "h": 7
      },
      "config": {
        "ref_id": "cisco-jina-md-lifecycle"
      }
    },
    {
      "id": "kpi-life",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 5
      },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"lifecycle\"\n| STATS `Lifecycle docs` = COUNT(*)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "Lifecycle docs"
          }
        ]
      }
    },
    {
      "id": "kpi-bytes",
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 7,
        "w": 24,
        "h": 5
      },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"lifecycle\" AND bytes IS NOT NULL\n| STATS `Payload bytes` = SUM(bytes)"
        },
        "metrics": [
          {
            "type": "primary",
            "column": "Payload bytes"
          }
        ]
      }
    },
    {
      "id": "life-sys",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "Lifecycle systems",
        "type": "pie",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"lifecycle\"\n| STATS docs = COUNT(*) BY system"
        },
        "metrics": [
          {
            "column": "docs"
          }
        ],
        "group_by": [
          {
            "column": "system"
          }
        ],
        "styling": {
          "donut_hole": "m"
        }
      }
    },
    {
      "id": "life-bytes",
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "Lifecycle payload bytes by system",
        "type": "data_table",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source == \"lifecycle\" AND bytes IS NOT NULL\n| STATS total_bytes = SUM(bytes) BY system\n| SORT total_bytes DESC"
        },
        "sampling": 1,
        "ignore_global_filters": false,
        "rows": [
          {
            "column": "system"
          },
          {
            "column": "total_bytes"
          }
        ],
        "styling": {
          "paging": 10
        }
      }
    }
  ]
}
