{
  "title": "Cisco Jina \u2014 Webex CCR East / West",
  "description": "Gov region \u00d7 source and Webex/infra artifacts.",
  "tags": [
    "cisco",
    "jina",
    "workshop",
    "cisco-search-jina"
  ],
  "time_range": {
    "from": "now-24h",
    "to": "now"
  },
  "options": {
    "use_margins": true,
    "sync_colors": true,
    "sync_cursor": true,
    "sync_tooltips": false,
    "hide_panel_titles": false,
    "auto_apply_filters": true,
    "hide_panel_borders": false
  },
  "query": {
    "expression": "",
    "language": "kuery"
  },
  "filters": [],
  "panels": [
    {
      "id": "md-hero",
      "type": "markdown",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 48,
        "h": 4
      },
      "config": {
        "content": "## Webex / Infrastructure\n\nCCR replicates; search locally \u2014 never cross the Gov boundary at query time.",
        "settings": {
          "open_links_in_new_tab": true
        }
      }
    },
    {
      "id": "webex-hm",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "Gov region \u00d7 source",
        "type": "heatmap",
        "data_source": {
          "type": "esql",
          "query": "FROM \"cisco-jina-corpus\"\n| WHERE region LIKE \"us-gov-*\"\n| STATS docs = COUNT(*) BY region, source"
        },
        "x": {
          "column": "source"
        },
        "y": {
          "column": "region"
        },
        "metric": {
          "column": "docs"
        }
      }
    },
    {
      "id": "webex-src",
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "Webex + infra by region",
        "type": "xy",
        "axis": {
          "x": {
            "title": {
              "visible": false
            }
          },
          "y": {
            "title": {
              "visible": false
            }
          }
        },
        "layers": [
          {
            "type": "bar",
            "data_source": {
              "type": "esql",
              "query": "FROM \"cisco-jina-corpus\"\n| WHERE source IN (\"webex\", \"infra\")\n| STATS docs = COUNT(*) BY region\n| SORT docs DESC"
            },
            "x": {
              "column": "region"
            },
            "y": [
              {
                "column": "docs"
              }
            ]
          }
        ]
      }
    }
  ]
}
