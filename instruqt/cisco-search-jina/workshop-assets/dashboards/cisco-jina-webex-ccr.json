{
  "title": "Cisco Jina — Webex CCR East / West",
  "description": "Gov region × source and Webex/infra artifacts.",
  "tags": ["cisco", "jina", "workshop", "cisco-search-jina"],
  "time_range": { "from": "now-7d", "to": "now" },
  "options": {
    "use_margins": true,
    "sync_colors": true,
    "sync_cursor": true,
    "sync_tooltips": false,
    "hide_panel_titles": false,
    "auto_apply_filters": true,
    "hide_panel_borders": false
  },
  "query": { "expression": "", "language": "kql" },
  "filters": [],
  "panels": [
    {
      "id": "md-hero",
      "type": "markdown",
      "grid": { "x": 0, "y": 0, "w": 48, "h": 4 },
      "config": {
        "content": "## Webex / Infrastructure\n\nCCR replicates; search locally — never cross the Gov boundary at query time.",
        "settings": { "open_links_in_new_tab": true }
      }
    },
    {
      "id": "kpi-gov",
      "type": "vis",
      "grid": { "x": 0, "y": 4, "w": 24, "h": 5 },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE region LIKE \"us-gov-*\"\n| STATS `Gov-region docs` = COUNT(*)"
        },
        "metrics": [{ "type": "primary", "column": "Gov-region docs" }]
      }
    },
    {
      "id": "kpi-webex",
      "type": "vis",
      "grid": { "x": 24, "y": 4, "w": 24, "h": 5 },
      "config": {
        "title": "",
        "type": "metric",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source IN (\"webex\", \"infra\")\n| STATS `Webex + infra` = COUNT(*)"
        },
        "metrics": [{ "type": "primary", "column": "Webex + infra" }]
      }
    },
    {
      "id": "webex-hm",
      "type": "vis",
      "grid": { "x": 0, "y": 9, "w": 24, "h": 12 },
      "config": {
        "title": "Gov region × source",
        "type": "data_table",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE region LIKE \"us-gov-*\"\n| STATS docs = COUNT(*) BY region, source\n| SORT docs DESC"
        },
        "sampling": 1,
        "ignore_global_filters": false,
        "rows": [
          { "column": "region" },
          { "column": "source" },
          { "column": "docs" }
        ],
        "styling": { "paging": 15 }
      }
    },
    {
      "id": "webex-src",
      "type": "vis",
      "grid": { "x": 24, "y": 9, "w": 24, "h": 12 },
      "config": {
        "title": "Webex + infra by region",
        "type": "pie",
        "data_source": {
          "type": "esql",
          "query": "FROM cisco-jina-corpus\n| WHERE source IN (\"webex\", \"infra\")\n| STATS docs = COUNT(*) BY region"
        },
        "metrics": [{ "column": "docs" }],
        "group_by": [{ "column": "region" }],
        "styling": { "donut_hole": "m" }
      }
    }
  ]
}
