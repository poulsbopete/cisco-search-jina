{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Lifecycle federation: Snowflake · S3 · Elastic",
  "description": "One question across warehouse facts, large payloads, and ops logs.",
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "axis": { "domainColor": "#444", "tickColor": "#444", "labelColor": "#333" },
    "view": { "stroke": null },
    "legend": { "title": null }
  },
  "data": {
    "url": {
      "%type%": "esql",
      "query": "FROM \"cisco-jina-corpus\" | WHERE source == \"lifecycle\" | STATS docs = COUNT(*) BY system"
    }
  },
  "mark": { "type": "arc", "innerRadius": 50 },
  "encoding": {
    "theta": { "field": "docs", "type": "quantitative" },
    "color": {
      "field": "system",
      "type": "nominal",
      "scale": { "range": ["#049FD9", "#0D274D", "#6B7280"] }
    },
    "tooltip": [
      { "field": "system", "type": "nominal" },
      { "field": "docs", "type": "quantitative" }
    ]
  }
}
