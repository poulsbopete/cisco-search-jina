{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Webex + infra artifacts by region",
  "description": "Recordings, decks, and CCR runbook — multimodal neighbors for the same legal concern.",
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "axis": { "domainColor": "#444", "tickColor": "#444", "labelColor": "#333" },
    "view": { "stroke": null }
  },
  "data": {
    "url": {
      "%type%": "esql",
      "query": "FROM \"cisco-jina-corpus\" | WHERE source IN (\"webex\", \"infra\") | STATS docs = COUNT(*) BY region, source"
    }
  },
  "mark": { "type": "bar", "color": "#049FD9" },
  "encoding": {
    "x": { "field": "region", "type": "nominal", "title": "Region" },
    "y": { "field": "docs", "type": "quantitative", "title": "Docs" },
    "color": { "field": "source", "type": "nominal", "title": "Source" },
    "xOffset": { "field": "source" },
    "tooltip": [
      { "field": "region", "type": "nominal" },
      { "field": "source", "type": "nominal" },
      { "field": "docs", "type": "quantitative" }
    ]
  }
}
