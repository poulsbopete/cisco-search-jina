{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Gov East / West × source (CCR story)",
  "description": "Replicate with CCR, search locally — same ranking on both sides of the Gov boundary.",
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "axis": { "domainColor": "#444", "tickColor": "#444", "labelColor": "#333" },
    "view": { "stroke": null }
  },
  "data": {
    "url": {
      "%type%": "esql",
      "query": "FROM \"cisco-jina-corpus\" | WHERE region LIKE \"us-gov-*\" | STATS docs = COUNT(*) BY region, source | SORT region, source"
    }
  },
  "mark": { "type": "rect" },
  "encoding": {
    "x": { "field": "source", "type": "nominal", "title": "Source" },
    "y": { "field": "region", "type": "nominal", "title": "Region" },
    "color": {
      "field": "docs",
      "type": "quantitative",
      "title": "Docs",
      "scale": { "scheme": "blues" }
    },
    "tooltip": [
      { "field": "region", "type": "nominal" },
      { "field": "source", "type": "nominal" },
      { "field": "docs", "type": "quantitative" }
    ]
  }
}
